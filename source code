void motorDirection(char dir) {
  reading = dir;
  int pwm = currentSpeed;
  
  if (dir == 'F') {
    analogWrite(en1, pwm); analogWrite(en2, pwm);
    digitalWrite(in1, LOW); digitalWrite(in2, HIGH);
    digitalWrite(in11, HIGH); digitalWrite(in22, LOW);   
  }
  else if (dir == 'B') {
    analogWrite(en1, pwm); analogWrite(en2, pwm);
    digitalWrite(in1, HIGH); digitalWrite(in2, LOW);
    digitalWrite(in11, LOW); digitalWrite(in22, HIGH);
  }
  else if (dir == 'R') { 
    analogWrite(en1, pwm); analogWrite(en2, 0);
    digitalWrite(in1, LOW); digitalWrite(in2, HIGH);
    digitalWrite(in11, LOW); digitalWrite(in22, LOW);
  }
  else if (dir == 'L') { 
    analogWrite(en1, 0); analogWrite(en2, pwm);
    digitalWrite(in1, LOW); digitalWrite(in2, LOW);
    digitalWrite(in11, HIGH); digitalWrite(in22, LOW);
  }
  else { // Stop ('S')
    analogWrite(en1, 0); analogWrite(en2, 0);
    digitalWrite(in1, LOW); digitalWrite(in2, LOW);
    digitalWrite(in11, LOW); digitalWrite(in22, LOW);
  }
}

void handleRoot() { server.send(200, "text/html", HTML_PAGE); }

void handleCommand() {
  if (server.hasArg("dir")) {
    char dir = server.arg("dir")[0];
    
   
    if ((dir == 'F' || dir == 'L' || dir == 'R') && distance > 0 && distance <= 7) {
      motorDirection('S');
    } else {
      motorDirection(dir);
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleSpeed() {
  if (server.hasArg("val")) {
    currentSpeed = server.arg("val").toInt();
    if (reading != 'S') motorDirection(reading); 
  }
  server.send(200, "text/plain", "OK");
}

void handleLight() {
  if (server.hasArg("state")) {
    digitalWrite(sensorLed, server.arg("state") == "ON" ? HIGH : LOW);
  }
  server.send(200, "text/plain", "OK");
}

void handleBuzzer() {
  if (server.hasArg("state")) {
    buzstate=server.arg("state") == "ON";
    if (buzstate) tone(buz, 1000); else noTone(buz);
  }
  server.send(200, "text/plain", "OK");
}

void setup() {
  pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(in11, OUTPUT); pinMode(in22, OUTPUT);
  pinMode(en1, OUTPUT); pinMode(en2, OUTPUT);
  
  pinMode(trig, OUTPUT); pinMode(echo, INPUT);
  pinMode(buz, OUTPUT); pinMode(leds, OUTPUT);
  pinMode(sensorLed,OUTPUT);
  
  mator.attach(saravevo);

  WiFi.softAP("EL DAWLY_CAR", "12345678");

  server.on("/", handleRoot);
  server.on("/cmd", handleCommand);
  server.on("/speed", handleSpeed);
  server.on("/light", handleLight);
  server.on("/buzzer", handleBuzzer);
  
  server.begin();
  Serial.begin(9600);
}

void loop() {
  millis_delay = millis();
  server.handleClient();

  // Ultrasonic Distance Measurement
  digitalWrite(trig, LOW);
  delayMicroseconds(2); 
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);

 
  duration = pulseIn(echo, HIGH, 30000); 
  distance = duration * sound_speed / 2;

  // Servo Radar Sweep
  if (millis_delay - previous_servo >= servo_interval) {
    previous_servo = millis_delay; 
    mator.write(servo_pos);
    servo_pos += servo_step; 

    if (servo_pos >= 135 || servo_pos <= 0) {
      servo_step = -servo_step; 
    }
  }

  // Active Emergency Stop
  if (distance > 0 && distance <= 25) { 
    if (reading == 'F' || reading == 'L' || reading == 'R') {
      motorDirection('S'); 
    }
    tone(buz, 555);

    if (millis_delay - previous_leds >= stop_delay) {
      digitalWrite(leds, !digitalRead(leds)); 
      previous_leds = millis_delay;
    }
  } else { 
    digitalWrite(leds,LOW);
    if (buzstate) tone(buz, 1000); else noTone(buz);
  }
}
