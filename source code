#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>
#include <string>


WebServer server(80);


#define trig 5
#define echo 19
#define saravevo 18
#define buz 33
#define leds 15
#define sensorLed 4
#define in1 26 // left
#define in2 27 // left
#define in11 14 // right 
#define in22 12 // right
#define en1 25 // left motor
#define en2 13 // right motor   

// Global State Variables
char reading = 'S';
int currentSpeed = 180;
const float sound_speed = 0.034;
unsigned long millis_delay = millis();
int columns = 16;
int rows = 2;
int delayTime = 250;
unsigned long pre_lcd = 0;

long duration;
float distance = 0;

bool buzstate=0;
unsigned long buztimer=0; 

int servo_pos = 0;
int servo_step = 3;  
unsigned long previous_servo = 0;
const int servo_interval = 20; 

unsigned long previous_leds = 0;
const unsigned long stop_delay = 150;


Servo mator;

// Dashboard UI
const char HTML_PAGE[] PROGMEM = R"rawliteral(
